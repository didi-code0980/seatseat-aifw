# Copy to .env.local. .env.local is gitignored; this file is not, so no real value belongs here.

# Which side of the seam serves data. `mock` is the default and needs no database.
# Anything other than `mock` or `prisma` is a startup error, not a silent fallback.
DATA_SOURCE=mock

# Better Auth. Both are required before the auth routes work; `pnpm build` logs a loud error
# without BETTER_AUTH_SECRET and the /api/auth handler will refuse to start.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL. Matches docker/docker-compose.yml. Unused while DATA_SOURCE=mock.
DATABASE_URL=postgresql://seat:seat@localhost:5432/seat?schema=public
