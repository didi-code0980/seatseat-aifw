# Copy to .env.local. .env.local is gitignored; this file is not, so no real value belongs here.
#
# Nothing loads this file automatically. Prisma 7 dropped dotenv — there is no dotenv in the CLI
# build and no env-file option in @prisma/config — so the `db:*` scripts read .env.local through
# Node's built-in --env-file-if-exists. `next dev` and `next build` load .env.local themselves.

# Which side of the seam serves data. `mock` is the default and needs no database.
# Anything other than `mock` or `prisma` is a startup error, not a silent fallback.
DATA_SOURCE=mock

# ---------------------------------------------------------------------------------------------
# Supabase — hosted Postgres only (ADR-002)
# ---------------------------------------------------------------------------------------------
# Supabase Auth, RLS, realtime and storage are out of scope. Authentication is Better Auth. There is
# no SUPABASE_URL and no anon key here on purpose: nothing in this application talks to Supabase
# except Prisma, over Postgres.
#
# Two URLs, because Supabase fronts Postgres with a connection pooler. Both are in the dashboard
# under Project Settings -> Database -> Connection string. Take the URI form, then substitute your
# database password for [YOUR-PASSWORD].
#
#   DATABASE_URL  the "Transaction pooler" entry. Port 6543. Append ?pgbouncer=true.
#                 This is the connection the running application uses.
#
#   DIRECT_URL    the "Direct connection" entry. Port 5432. No pgbouncer parameter.
#                 This is the connection migrations use, and it is what prisma.config.ts reads.
#
# The pooler runs in transaction mode, which cannot hold the session state that prepared statements
# and advisory locks need. Migrations through port 6543 fail in ways that look intermittent, which is
# why the direct URL exists rather than being a convenience.

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------------------------
# Better Auth — unchanged by the Supabase decision
# ---------------------------------------------------------------------------------------------
# Both are required before the auth routes work; `pnpm build` logs a loud error without the secret
# and the /api/auth handler refuses to start.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
