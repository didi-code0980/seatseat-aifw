# Copy to .env.local. .env.local is gitignored; this file is not, so no real value belongs here.
#
# Nothing loads this file automatically. `next dev` and `next build` load .env.local themselves;
# `pnpm db:seed` reads it through Node's built-in --env-file-if-exists, and the Supabase CLI is
# given a connection string on the command line rather than reading one from here.

# Which side of the seam serves data. Since ADR-007 the DEFAULT IS `supabase`: an empty or absent
# value means the real database, not the fixtures. Anything other than `mock` or `supabase` is a
# startup error, not a silent fallback.
#
# `mock` is what lets the unit suite run with no network at all, and it is pinned there in
# vitest.config.mts and playwright.config.ts rather than being set per developer.
DATA_SOURCE=supabase

# ---------------------------------------------------------------------------------------------
# Supabase — Postgres, the data client, and the identity provider
# ---------------------------------------------------------------------------------------------
# ADR-002 made Supabase hosted Postgres. ADR-006 added authentication. ADR-007 made it the data
# client too and removed Prisma: `@supabase/ssr` for auth in `src/lib/auth/`, `@supabase/supabase-js`
# for data in `src/lib/data/supabase/`, and neither directory may name the other's package.
#
# RLS, realtime and storage remain out of scope. RLS stays off by decision (ADR-002) on ONE
# condition, restated by ADR-007 clause 4: every Supabase client is constructed server-side only. The
# day that is false, RLS becomes mandatory rather than advisable.
#
# NONE of the names below carries a NEXT_PUBLIC_ prefix and that is the mechanism, not a preference.
# Next inlines every NEXT_PUBLIC_* variable into the browser bundle at build time; without the prefix
# the value cannot reach a client component at all.

# Project Settings -> API. The anon key is normally safe to expose because RLS guards it; RLS is off
# here, so it is unrestricted read and write and it is server-only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------------------------
# Migrations — the one connection string this project still needs
# ---------------------------------------------------------------------------------------------
# THE RUNNING APPLICATION OPENS NO POSTGRES CONNECTION. `@supabase/supabase-js` speaks HTTP to
# PostgREST: it needs SUPABASE_URL and a key and no connection string at all. So DATABASE_URL — the
# pooled, port-6543, ?pgbouncer=true runtime connection that Prisma used — has left this project
# entirely, and nothing reads it.
#
# DIRECT_URL survives, and only migrations read it:
#
#     pnpm supabase db push --db-url "$DIRECT_URL"
#
# Project Settings -> Database -> Connection string, the "Direct connection" entry. Port 5432, no
# pgbouncer parameter, percent-encoded. The pooler runs in transaction mode and cannot hold the
# session state a migration needs; migrations through 6543 fail in ways that look intermittent. That
# is a property of Supabase's pooler and it survived Prisma's departure unchanged.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------------------------
# Seeding — scripts/seed.ts and nothing else
# ---------------------------------------------------------------------------------------------
# The service-role key bypasses RLS entirely; with RLS off that is simply full read and write on
# every table. ADR-007 puts it in the seed script "and to nothing else", and the seed refuses to run
# with NODE_ENV=production. Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=

# One password per fixture account, named from its id. The seed creates the three auth.users rows
# through the admin API and writes their ids into Account.auth_user_id; without them the cutover
# produces a full database nobody can sign in to. There is no default: a seeded login with a
# password baked into version control is a credential in version control.
SEED_PASSWORD_ACC_ADMIN=
SEED_PASSWORD_ACC_MANAGER=
SEED_PASSWORD_ACC_USER=
