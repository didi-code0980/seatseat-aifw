# Copy to .env.local. .env.local is gitignored; this file is not, so no real value belongs here.
#
# Nothing loads this file automatically. Prisma 7 dropped dotenv — there is no dotenv in the CLI
# build and no env-file option in @prisma/config — so the `db:*` scripts read .env.local through
# Node's built-in --env-file-if-exists. `next dev` and `next build` load .env.local themselves.

# Which side of the seam serves data. `mock` is the default and needs no database.
# Anything other than `mock` or `prisma` is a startup error, not a silent fallback.
DATA_SOURCE=mock

# ---------------------------------------------------------------------------------------------
# Supabase — Postgres, and since ADR-006 the identity provider too
# ---------------------------------------------------------------------------------------------
# ADR-002 made Supabase hosted Postgres and nothing else. ADR-006 added authentication: Better Auth
# is gone, and Supabase Auth replaces it, constructed server-side only from `src/lib/auth/`. The
# connection strings below are unchanged by that decision — they are Prisma's, and they are separate
# from the two Supabase Auth variables further down.
#
# RLS, realtime and storage remain out of scope. RLS stays off by decision (ADR-002): `src/lib/data/`
# is the single authorization point, and two layers enforcing permissions is a drift source.
#
# Two URLs, because Supabase fronts Postgres with a connection pooler. Both are in the dashboard
# under Project Settings -> Database -> Connection string. Take the URI form, then substitute your
# database password for [YOUR-PASSWORD].
#
#   DATABASE_URL  the "Transaction pooler" entry. Port 6543. Append ?pgbouncer=true.
#                 This is the connection the running application uses.
#
#   DIRECT_URL    the "Direct connection" entry. Port 5432. No pgbouncer parameter.
#                 This is the connection migrations use, and it is what prisma.config.ts reads.
#
# The pooler runs in transaction mode, which cannot hold the session state that prepared statements
# and advisory locks need. Migrations through port 6543 fail in ways that look intermittent, which is
# why the direct URL exists rather than being a convenience.

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------------------------
# Supabase Auth (ADR-006)
# ---------------------------------------------------------------------------------------------
# The client is constructed server-side only (ADR-006 OQ-1), so NEITHER of these carries the
# NEXT_PUBLIC_ prefix. Next inlines NEXT_PUBLIC_* into the browser bundle at build time; without the
# prefix the value cannot reach a client component at all, which is how "no Supabase credential
# reaches the browser" is a property of the naming rather than a promise about discipline.
#
# Both are in the dashboard under Project Settings -> API. The anon key is the publishable key and is
# still server-only here: RLS is off (ADR-002), so it is not safe to expose.

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
