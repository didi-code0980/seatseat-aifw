{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b feat/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "mcp__clickup__clickup_get_task",
      "mcp__clickup__clickup_update_task",
      "mcp__clickup__clickup_get_custom_fields",
      "mcp__clickup__clickup_create_comment",
      "mcp__clickup__clickup_filter_tasks",
      "Bash(command -v nvm fnm volta n asdf mise)",
      "Read(//Users/mpa/.nvm/**)",
      "Bash(brew list *)",
      "Bash(command -v brew)",
      "Bash(brew info *)",
      "Bash(node -e 'let s=\"\";process.stdin.on\\(\"data\",d=>s+=d\\).on\\(\"end\",\\(\\)=>{try{const j=JSON.parse\\(s\\);const f=j.formulae[0];console.log\\(\"node@24:\",f.versions.stable,\"keg_only:\",f.keg_only\\)}catch\\(e\\){console.log\\(\"node@24 not found\"\\)}}\\)')",
      "Bash(node -e 'let s=\"\";process.stdin.on\\(\"data\",d=>s+=d\\).on\\(\"end\",\\(\\)=>{try{const j=JSON.parse\\(s\\);const f=j.formulae[0];console.log\\(\"node@22:\",f.versions.stable,\"keg_only:\",f.keg_only\\)}catch\\(e\\){console.log\\(\"node@22 not found\"\\)}}\\)')",
      "Bash(brew search *)",
      "Bash(node -e ' *)",
      "Bash(node -e 'const p=require\\(\"./node_modules/@prisma/client/package.json\"\\);console.log\\(JSON.stringify\\({main:p.main,types:p.types,exports:Object.keys\\(p.exports||{}\\)},null,1\\)\\)')",
      "Bash(node node_modules/prisma/build/index.js --version)",
      "Bash(node -e 'const p=require\\(\"./node_modules/eslint-config-next/package.json\"\\);console.log\\(JSON.stringify\\({main:p.main,exports:p.exports},null,1\\)\\)')",
      "Bash(node -e 'const p=require\\(\"./node_modules/better-auth/package.json\"\\);console.log\\(Object.keys\\(p.exports||{}\\).join\\(\"\\\\n\"\\)\\)')",
      "Bash(grep -o \"declare const betterAuth[^;]\\\\{0,200\\\\}\\\\|declare function betterAuth[^;]\\\\{0,200\\\\}\" node_modules/better-auth/dist/auth.d.mts)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(node -e 'const p=require\\(\"./node_modules/typescript-eslint/package.json\"\\);console.log\\(\"typescript-eslint\",p.version\\);console.log\\(\"peer:\",JSON.stringify\\(p.peerDependencies\\)\\)')",
      "Bash(node -e 'let s=\"\";process.stdin.on\\(\"data\",d=>s+=d\\).on\\(\"end\",\\(\\)=>{const v=JSON.parse\\(s\\);const f=v.filter\\(x=>/^\\(5\\\\.[89]|6\\\\.\\)/.test\\(x\\)&&!x.includes\\(\"-\"\\)\\);console.log\\(f.join\\(\", \"\\)\\)}\\)')",
      "Bash(git mv *)",
      "Bash(node -e 'console.log\\(require\\(\"./node_modules/typescript/package.json\"\\).version\\)')",
      "Bash(echo \"EXIT=$?\")",
      "Bash(node -e 'for\\(const p of [\"next\",\"typescript\",\"vitest\",\"eslint\",\"@prisma/client\",\"better-auth\"]\\){console.log\\(p, require\\(`./node_modules/${p}/package.json`\\).version\\)}')",
      "Bash(node -e 'require\\(\"esbuild\"\\);console.log\\(\"esbuild loads\"\\)')",
      "Bash(echo \"TYPECHECK=$?\")",
      "Bash(node -e 'let s=\"\";process.stdin.on\\(\"data\",d=>s+=d\\).on\\(\"end\",\\(\\)=>{const v=JSON.parse\\(s\\).filter\\(x=>/^9\\\\./.test\\(x\\)&&!x.includes\\(\"-\"\\)\\);console.log\\(v.slice\\(-3\\).join\\(\", \"\\)\\)}\\)')",
      "Bash(pnpm build *)",
      "Bash(node node_modules/prisma/build/index.js validate --schema prisma/schema.prisma)",
      "Bash(node -e 'const p=require\\(\"./node_modules/prisma/package.json\"\\);console.log\\(Object.keys\\(p.exports||{}\\).join\\(\" \"\\)\\)')",
      "Bash(node --test .claude/hooks/tests/)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm verify *)",
      "Bash(echo \"VERIFY_EXIT=$?\")",
      "Bash(cp /tmp/rooms-page.bak src/app/\\\\\\(app\\\\\\)/rooms/page.tsx)",
      "Bash(rm /tmp/rooms-page.bak)",
      "Bash(echo \"LINT_EXIT=$?\")",
      "Bash(command -v docker)",
      "Bash(docker compose *)",
      "Bash(grep -rhoE 'data-testid=\\\\{`[^`]*`\\\\}' src/)",
      "Bash(git switch *)",
      "Bash(node .claude/hooks/guard-allowed-paths.mjs)",
      "Bash(echo \"  [exit=$?]\")",
      "Bash(node .claude/hooks/chat-guard.mjs)",
      "Bash(cp src/lib/data/mock/rooms.ts /tmp/rooms-mock.bak)",
      "Bash(node -e 'const fs=require\\(\"fs\"\\);const f=\"src/lib/data/mock/rooms.ts\";let s=fs.readFileSync\\(f,\"utf8\"\\);s=s.replace\\(/export async function getRoom[\\\\s\\\\S]*$/,\"\"\\);fs.writeFileSync\\(f,s\\);')",
      "Bash(cp /tmp/rooms-mock.bak src/lib/data/mock/rooms.ts)",
      "Bash(rm /tmp/rooms-mock.bak)",
      "Bash(node --test scripts/tests/*.test.mjs)",
      "Bash(cp prisma/schema.prisma /tmp/schema.bak)",
      "Bash(node -e 'const fs=require\\(\"fs\"\\);const f=\"prisma/schema.prisma\";let s=fs.readFileSync\\(f,\"utf8\"\\);s=s.replace\\(/datasource db \\\\{\\\\n  provider = \"postgresql\"\\\\n\\\\}/,`datasource db {\\\\n  provider  = \"postgresql\"\\\\n  directUrl = env\\(\"DIRECT_URL\"\\)\\\\n}`\\);fs.writeFileSync\\(f,s\\);')",
      "Bash(export DATABASE_URL=\"postgresql://u:p@h:6543/db?pgbouncer=true\" DIRECT_URL=\"postgresql://u:p@h:5432/db\")",
      "Bash(cp /tmp/schema.bak prisma/schema.prisma)",
      "Bash(grep -n \"INV-0\\\\` + \\\\`9\\\\|^| INV-09\" .ai/registry/invariants.md)",
      "Bash(echo \"verify: exit $?\")",
      "Bash(pnpm hooks:test)",
      "Bash(echo \"test:e2e: exit $?\")",
      "Bash(cp eslint.config.mjs /tmp/e.bak)",
      "Bash(node -e 'const fs=require\\(\"fs\"\\);let s=fs.readFileSync\\(\"eslint.config.mjs\",\"utf8\"\\);s=s.replace\\(`\"@prisma/client\",`,`\"@prisma/client\",\\\\n \"@supabase/supabase-js\",`\\);fs.writeFileSync\\(\"eslint.config.mjs\",s\\);')",
      "Bash(cp /tmp/e.bak eslint.config.mjs)",
      "Bash(rm /tmp/e.bak)",
      "Bash(cp /tmp/i.bak .ai/standards/integrations.md)",
      "Bash(rm /tmp/i.bak)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "mcp__clickup__clickup_delete_task",
      "mcp__clickup__clickup_merge_tasks",
      "mcp__clickup__clickup_move_task",
      "mcp__clickup__clickup_send_chat_message",
      "mcp__clickup__clickup_search",
      "mcp__clickup__clickup_get_workspace_hierarchy"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-project-root.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-registry.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-allowed-paths.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chat-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__clickup__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tracker-scope.mjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/chat-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-read-scope.mjs\""
          }
        ]
      }
    ]
  }
}
